 DEFINE_LINKED_LIST (SetupOp, op)

+/* Host identity and namespace non-ownership are distinct checks. Host root
+ * is normally unmapped in our private user namespace; never hardcode the
+ * kernel's overflow IDs as if they were host ownership. */
+static bool
+entropy_identity_matches (const struct stat *st, bool host,
+                          uid_t caller_uid, gid_t caller_gid)
+{
+  if (!S_ISCHR (st->st_mode) || st->st_rdev != makedev (1, 9) ||
+      (st->st_mode & 07777) != 0666 || st->st_nlink != 1)
+    return FALSE;
+  if (host)
+    return st->st_uid == 0 && st->st_gid == 0;
+  return st->st_uid != caller_uid && st->st_gid != caller_gid;
+}
+
+static void
+verify_host_entropy (void)
+{
+  struct stat st;
+  char *canonical;
+  if (!opt_readonly_entropy)
+    return;
+  canonical = realpath ("/dev/urandom", NULL);
+  if (canonical == NULL || strcmp (canonical, "/dev/urandom") != 0)
+    die ("Fixed host entropy path is not canonical");
+  free (canonical);
+  if (lstat ("/dev/urandom", &st) != 0)
+    die_with_error ("Can't stat fixed host entropy source");
+  if (!entropy_identity_matches (&st, TRUE, real_uid, real_gid))
+    die ("Fixed host entropy source identity differs");
+}
+
+
+/* This is an additional write-open guard, not a replacement for readonly
+ * mount/inode protection. It runs after final mount topology, single-threaded,
+ * before any workload exec. No writable entropy descriptor is ever opened.
+ */
+static void
+entropy_allow_write (int ruleset, const char *path, bool null_device)
+{
+  struct landlock_path_beneath_attr rule = {
+    .allowed_access = LANDLOCK_ACCESS_FS_WRITE_FILE | LANDLOCK_ACCESS_FS_TRUNCATE,
+  };
+  struct stat st;
+  char *canonical = realpath (path, NULL);
+  if (canonical == NULL || strcmp (canonical, path) != 0)
+    die ("Noncanonical entropy write grant");
+  free (canonical);
+  if (!null_device && (strcmp (path, "/") == 0 || strcmp (path, "/dev") == 0 ||
+                       strncmp (path, "/dev/", 5) == 0))
+    die ("Entropy write grant overlaps device authority");
+  rule.parent_fd = open (path, O_PATH | O_NOFOLLOW | O_CLOEXEC);
+  if (rule.parent_fd < 0 || fstat (rule.parent_fd, &st) != 0)
+    die_with_error ("Can't bind entropy write grant");
+  if (null_device)
+    {
+      if (!S_ISCHR (st.st_mode) || st.st_rdev != makedev (1, 3))
+        die ("Entropy null grant identity differs");
+    }
+  else if (!S_ISDIR (st.st_mode) && !S_ISREG (st.st_mode))
+    die ("Entropy output grant is not a file or directory");
+  if (syscall (__NR_landlock_add_rule, ruleset, LANDLOCK_RULE_PATH_BENEATH, &rule, 0) != 0)
+    die_with_error ("Can't add mandatory entropy write rule");
+  if (close (rule.parent_fd) != 0)
+    die_with_error ("Can't close entropy rule descriptor");
+}
+
+static void
+restrict_entropy_writes (void)
+{
+  struct landlock_ruleset_attr attr = {
+    .handled_access_fs = LANDLOCK_ACCESS_FS_WRITE_FILE |
+                         LANDLOCK_ACCESS_FS_TRUNCATE |
+                         LANDLOCK_ACCESS_FS_MAKE_CHAR |
+                         LANDLOCK_ACCESS_FS_MAKE_BLOCK,
+  };
+  SetupOp *op;
+  int ruleset;
+
+  if (!opt_readonly_entropy)
+    return;
+  if (prctl (PR_GET_NO_NEW_PRIVS, 0, 0, 0, 0) != 1)
+    die ("Entropy write confinement requires no_new_privs");
+  if (syscall (__NR_landlock_create_ruleset, NULL, 0, LANDLOCK_CREATE_RULESET_VERSION) < 3)
+    die ("Entropy write confinement requires Landlock ABI >= 3");
+  ruleset = syscall (__NR_landlock_create_ruleset, &attr, sizeof (attr), 0);
+  if (ruleset < 0)
+    die_with_error ("Can't create mandatory entropy write ruleset");
+  for (op = ops; op != NULL; op = op->next)
+    {
+      if (op->type == SETUP_BIND_MOUNT)
+        {
+          if (op->flags != 0)
+            die ("Conditional entropy write grant refused");
+          entropy_allow_write (ruleset, op->dest, FALSE);
+        }
+      else if (op->type == SETUP_DEV_BIND_MOUNT ||
+               op->type == SETUP_MOUNT_DEV ||
+               op->type == SETUP_MOUNT_TMPFS ||
+               op->type == SETUP_MOUNT_MQUEUE ||
+               op->type == SETUP_MAKE_BIND_FILE)
+        die ("Unexpected writable entropy topology");
+    }
+  entropy_allow_write (ruleset, "/dev/null", TRUE);
+  if (syscall (__NR_landlock_restrict_self, ruleset, 0) != 0)
+    die_with_error ("Can't enforce mandatory entropy write confinement");
+  if (close (ruleset) != 0)
+    die_with_error ("Can't close entropy ruleset descriptor");
+}
+
